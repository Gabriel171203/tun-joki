# Konfigurasi Admin WhatsApp (Gunakan kode negara tanpa +, misal: 6281234567890)
NEXT_PUBLIC_ADMIN_WHATSAPP=6281234567890
NEXT_PUBLIC_ADMIN_NAME="Admin Tuntasin"

# Konfigurasi Supabase (Dapatkan di Dashboard Supabase -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Dipakai API routes di server-side saja (insert & tracking orders).
# Jangan pernah mengimpor modul ini dari komponen client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Storage Buckets
NEXT_PUBLIC_STORAGE_BUCKET_PAYMENTS=payment-proofs
NEXT_PUBLIC_STORAGE_BUCKET_TASKS=task-files

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Token akses API admin (/api/admin/*), kirim: Authorization: Bearer <token>
# Generate acak: openssl rand -hex 24
ADMIN_API_TOKEN=

# Email konfirmasi pesanan via Gmail SMTP (gratis, tanpa domain).
# Buat App Password: Google Account → Security → 2-Step Verification → App passwords.
GMAIL_USER=
GMAIL_APP_PASSWORD=
